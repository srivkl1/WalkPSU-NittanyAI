{
  "name": "walkpsu-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "fetch-buildings": "node scripts/fetch-buildings.mjs",
    "import-events": "node scripts/import-discover-events.mjs",
    "sync-events": "node --disable-warning=ExperimentalWarning scripts/sync-discover-events.mjs",
    "seed-events": "node scripts/seed-event-drops.mjs",
    "test-gemini": "node --disable-warning=ExperimentalWarning scripts/test-gemini.ts",
    "test:sql": "node tests/sql/run.mjs",
    "test:api": "node --disable-warning=ExperimentalWarning tests/api/verify-photo.test.mjs && node --disable-warning=ExperimentalWarning tests/api/search-events.test.mjs && node --disable-warning=ExperimentalWarning tests/api/sync-events.test.mjs && node --disable-warning=ExperimentalWarning tests/api/gemini-timeout.test.mjs",
    "test:unit": "node --disable-warning=ExperimentalWarning tests/unit/interests.test.mjs",
    "test:e2e": "node tests/e2e/run.mjs",
    "test": "npm run test:unit && npm run test:sql && npm run test:api && npm run test:e2e",
    "mock": "node tests/mock/supabase.mjs"
  },
  "dependencies": {
    "@auth0/auth0-react": "^2.28.2",
    "@supabase/supabase-js": "^2.118.0",
    "maplibre-gl": "^6.15.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-map-gl": "^8.1.3",
    "react-router": "^8.5.0",
    "sonner": "^2.0.8",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@eslint/js": "^10.0.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "mapshaper": "^0.7.98",
    "playwright-core": "^1.56.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
