# Client-side (VITE_ vars are bundled into the browser build; never put secrets here)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Auth0. Leave blank to use the fallback "enter your name" login (Supabase anonymous sign-in).
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
# Optional: API identifier, only needed once /api functions verify Auth0 access tokens
VITE_AUTH0_AUDIENCE=

# Server-only (Vercel functions in web/api). Never prefix with VITE_.
GEMINI_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Shared with Supabase pg_cron, which calls /api/sync-events with it (docs/SETUP.md). Any long random string.
DISCOVER_SYNC_SECRET=
